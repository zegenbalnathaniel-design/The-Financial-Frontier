  "highlights": [
    {
      "tag": "Policy",
      "title": "The Fed hikes — unanimously",
      "blurb": "A 12–0 vote lifted the target range to 3.75–4.00%. Officials signalled at least one more move by year-end, and Warsh's press conference turned an early rally into a sell-off."
    },
    {
      "tag": "Policy",
      "title": "Three banks, one week",
      "blurb": "The ECB lifted its deposit rate to 2.50% and the Bank of Japan went to 1.25%, a 30-year high. The Bank of England held only by 6–3."
    },
    {
      "tag": "Energy",
      "title": "Brent breaks $100",
      "blurb": "After the White House rejected Iran's offer to reopen the Strait within seven days, Brent briefly neared $110 and ended the quarter around $103."
    },
    {
      "tag": "Bonds",
      "title": "The long end cracks",
      "blurb": "The 10-year Treasury yield hit 5.29%, its highest since 2002, as investors demanded more to hold government debt through an inflationary war."
    },
    {
      "tag": "Markets",
      "title": "A narrow, fragile market",
      "blurb": "The S&P 500 slipped only about 0.3%, but the median stock fell 5.1% — one of the widest gaps between headline and typical stock since 2003."
    },
