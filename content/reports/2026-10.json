  "highlights": [
    {
      "tag": "Global",
      "title": "Up a tenth, down in spirit",
      "blurb": "The IMF raised 2026 growth to 3.1% but noted just 32 economies now produce 95% of global growth, versus 54 in April. Risks are skewed to the downside."
    },
    {
      "tag": "US",
      "title": "A 3.4% quarter",
      "blurb": "US real GDP grew at a 3.4% annualised pace in Q3, up from 2.2% in Q2, carried by consumers, business investment and government spending."
    },
    {
      "tag": "Markets",
      "title": "The great rotation",
      "blurb": "The headline S&P 500 fell about 0.9% while the equal-weight index rose 5%. Nvidia slid around 10% and ceded the world's-most-valuable crown to Apple."
    },
    {
      "tag": "Energy",
      "title": "Tankers, mines and $117 oil",
      "blurb": "Attacks on shipping near Hormuz drove Brent up about 14% in October — its fourth straight monthly gain."
    },
    {
      "tag": "Europe",
      "title": "Lagarde's early exit",
      "blurb": "The ECB held its deposit rate at 2.50% on 29 October, and Lagarde announced she will step down on 7 February 2027, nine months early. Euro inflation hit 4.0%."
    },
    {
      "tag": "Asia",
      "title": "India turns hawkish",
      "blurb": "The RBI raised its repo rate 25bp to 5.50% and moved to 'calibrated tightening', saying the next step can only be a hike or a pause."
    }
