  "highlights": [
    {
      "tag": "Policy",
      "title": "'A firm, fixed target'",
      "blurb": "Warsh's first Jackson Hole keynote tied the Fed to 2% PCE inflation and warned of further tightening if progress stalls. Markets moved to price roughly a 60% chance of a September hike."
    },
    {
      "tag": "Commodities",
      "title": "Gold's best month in years",
      "blurb": "Gold futures rose about 9% and silver about 15% as investors bought hard assets — the 'debasement trade' — against swelling deficits and a softer dollar."
    },
    {
      "tag": "Markets",
      "title": "Records, despite the rhetoric",
      "blurb": "The S&P 500 posted three record closes and gained about 2.7%, with growth and tech recovering from July's slide."
    },
    {
      "tag": "Labour",
      "title": "Hiring snaps back",
      "blurb": "Payrolls rose 162,000 against a consensus near 53,000 and unemployment held at 4.1% — the data point that made a hike look justified."
    },
    {
      "tag": "Europe",
      "title": "The ECB clears its throat",
      "blurb": "Euro-area inflation climbed to 3.2%, and Governing Council members openly argued for a September hike given Middle East energy pressure."
    },
    {
      "tag": "Asia",
      "title": "India's 7.8% quarter",
      "blurb": "India's April–June GDP grew 7.8% year on year, led by investment (+11.9%) and services, comfortably beating the RBI's projection."
    }
