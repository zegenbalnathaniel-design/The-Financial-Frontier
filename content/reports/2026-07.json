  "highlights": [
    {
      "tag": "Energy",
      "title": "The truce breaks, the strait shuts",
      "blurb": "Attacks on three commercial vessels and US strikes on Iran ended the spring ceasefire. With Hormuz again closed to commercial shipping, WTI rose about 22% in a month."
    },
    {
      "tag": "Policy",
      "title": "A Fed divided — upward",
      "blurb": "The Fed held at 3.50–3.75% for a fifth meeting, but three voters wanted a hike. A split this wide hadn't been seen in a decade, and it leaned hawkish."
    },
    {
      "tag": "Global",
      "title": "The IMF splits the difference",
      "blurb": "The July WEO Update put 2026 growth at 3.0% and 2027 at 3.4% — a war-driven supply shock pulling down, an AI investment boom pushing up."
    },
    {
      "tag": "Markets",
      "title": "The AI trade's worst month since 2025",
      "blurb": "The Nasdaq 100 fell about 6.6% on doubts about AI capital spending, while the equal-weight S&P 500 gained 1.1%. The market didn't fall; it rotated."
    },
    {
      "tag": "Labour",
      "title": "A payrolls wobble",
      "blurb": "July payrolls came in negative against expectations of a modest gain — a soft print that complicated the hawks' case without ending it."
    },
    {
      "tag": "Europe",
      "title": "Inflation turns the corner — upward",
      "blurb": "Euro-area inflation edged up to 2.9% from 2.8%, the first step in what became a sharp autumn climb as energy fed through."
    }
  ],
