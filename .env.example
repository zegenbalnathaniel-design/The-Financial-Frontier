# ── Live data API keys ───────────────────────────────────────────────────────
# All optional. With none set, the site still works: World Bank (growth, inflation,
# per-capita, unemployment, current account, fiscal balance, debt, trade, FDI, market
# cap, broad money) and ECB/Frankfurter FX update live for free with NO key. Anything
# else falls back to clearly-labelled sample data.

# FRED — policy rates, 10-year government-bond yields, US unemployment.
# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Finnhub — daily equity-index moves (the `change` field). Free tier has limited index
# coverage; some symbols need a paid plan and are skipped gracefully.
# Free key: https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Optional: protect the daily cron endpoint (/api/refresh). If set, Vercel Cron sends
# it automatically as a Bearer token. Any random string works.
CRON_SECRET=
